K,CAACZ,KAYlC,CACV,CAAC,CACC,CAAC,EACC,CAAC,EACN,CAAC,CAEX,CAEeK,mDAAG,E;;;;;AC3MlB+B,mBAAQ,CAACC,MAAM,cACblB,0BAAA,CAACmB,eAAK,CAACC,UAAU,EAAAvB,QAAA,cACfG,0BAAA,CAACd,OAAG,GAAE,CAAC,CACS,CAAC,CACnBmC,QAAQ,CAACC,cAAc,CAAC,MAAM,CAChC,CAAC,C;;;;;;;ACVD,uC","file":"x","sourcesContent":["// extracted by mini-css-extract-plugin","import { FormEvent, useState } from 'react';\r\nimport './App.css';\r\n\r\nconst events = [\r\n  {\r\n    day: '08',\r\n    month: 'SET',\r\n    category: 'Musica',\r\n    title: 'Roda de Choro na Praca',\r\n    place: 'Praca da Matriz',\r\n    time: '18h30',\r\n    image: 'https://images.unsplash.com/photo-1493225457124-a3eb161ffa5f?auto=format&fit=crop&w=900&q=80',\r\n    tone: 'coral',\r\n  },\r\n  {\r\n    day: '10',\r\n    month: 'SET',\r\n    category: 'Cinema',\r\n    title: 'Cinema na Rua: O Auto da Compadecida',\r\n    place: 'Coreto Municipal',\r\n    time: '19h',\r\n    image: 'https://images.unsplash.com/photo-1485846234645-a62644f84728?auto=format&fit=crop&w=900&q=80',\r\n    tone: 'gold',\r\n  },\r\n  {\r\n    day: '12',\r\n    month: 'SET',\r\n    category: 'Exposicao',\r\n    title: 'Memorias do Nosso Lugar',\r\n    place: 'Casa da Cultura',\r\n    time: '09h as 17h',\r\n    image: 'https://images.unsplash.com/photo-1561214115-f2f134cc4912?auto=format&fit=crop&w=900&q=80',\r\n    tone: 'blue',\r\n  },\r\n  {\r\n    day: '14',\r\n    month: 'SET',\r\n    category: 'Teatro',\r\n    title: 'A Menina e o Vento',\r\n    place: 'Teatro Municipal',\r\n    time: '16h',\r\n    image: 'https://images.unsplash.com/photo-1503095396549-807759245b35?auto=format&fit=crop&w=900&q=80',\r\n    tone: 'green',\r\n  },\r\n];\r\n\r\nfunction App() {\r\n  const [activeView, setActiveView] = useState<'agenda' | 'editais'>('agenda');\r\n  const [submitted, setSubmitted] = useState(false);\r\n\r\n  function handleSubmit(event: FormEvent<HTMLFormElement>) {\r\n    event.preventDefault();\r\n    setSubmitted(true);\r\n  }\r\n\r\n  if (activeView === 'editais') {\r\n    return (\r\n      <main className=\"app-shell\">\r\n        <header className=\"site-header\">\r\n          <button className=\"brand brand-button\" type=\"button\" onClick={() => setActiveView('agenda')} aria-label=\"Cultura em movimento, inicio\">\r\n            <span className=\"brand-mark\">C</span>\r\n            <span>Cultura<br />em movimento</span>\r\n          </button>\r\n          <nav aria-label=\"Navegacao principal\">\r\n            <button type=\"button\" onClick={() => setActiveView('agenda')}>Agenda</button>\r\n            <button className=\"nav-active\" type=\"button\">Editais</button>\r\n            <a href=\"#sobre\">Sobre</a>\r\n          </nav>\r\n          <button className=\"calendar-button\" type=\"button\" onClick={() => setActiveView('agenda')}>Ver agenda</button>\r\n        </header>\r\n\r\n        <section className=\"edital-page\" aria-labelledby=\"edital-title\">\r\n          <div className=\"edital-intro\">\r\n            <p className=\"eyebrow\">Inscricoes abertas</p>\r\n            <h1 id=\"edital-title\">Seu trabalho pode ganhar espaco na cidade.</h1>\r\n            <p>Inscreva sua proposta no Edital Cultura em Movimento 2026. Selecione a linguagem artistica e conte o que voce quer realizar.</p>\r\n            <aside className=\"notice\">\r\n              <strong>Prazo de inscricao</strong>\r\n              <span>ate 30 de setembro de 2026, 23h59</span>\r\n            </aside>\r\n            <dl className=\"edital-summary\">\r\n              <div><dt>Fomento</dt><dd>R$ 5 mil a R$ 20 mil</dd></div>\r\n              <div><dt>Quem pode</dt><dd>Artistas e coletivos locais</dd></div>\r\n            </dl>\r\n          </div>\r\n\r\n          <section className=\"application-panel\" aria-labelledby=\"form-title\">\r\n            {submitted ? (\r\n              <div className=\"success-message\" role=\"status\">\r\n                <p className=\"eyebrow\">Inscricao recebida</p>\r\n                <h2>Seu projeto entrou na nossa lista.</h2>\r\n                <p>Enviaremos uma confirmacao para o e-mail informado. Guarde este protocolo: <strong>CM-2026-0841</strong>.</p>\r\n                <button className=\"details-button\" type=\"button\" onClick={() => setSubmitted(false)}>Enviar outra inscricao</button>\r\n              </div>\r\n            ) : (\r\n              <form onSubmit={handleSubmit}>\r\n                <div className=\"form-heading\">\r\n                  <p className=\"eyebrow\">Etapa 1 de 1</p>\r\n                  <h2 id=\"form-title\">Dados da proposta</h2>\r\n                  <p>Os campos marcados com * sao obrigatorios.</p>\r\n                </div>\r\n                <div className=\"form-grid\">\r\n                  <label>Nome completo *<input name=\"name\" required placeholder=\"Como voce se apresenta\" /></label>\r\n                  <label>E-mail *<input name=\"email\" type=\"email\" required placeholder=\"voce@email.com\" /></label>\r\n                  <label className=\"full-width\">Nome da proposta *<input name=\"project\" required placeholder=\"De um nome para o seu projeto\" /></label>\r\n                  <label>Area cultural *\r\n                    <select name=\"area\" required defaultValue=\"\">\r\n                      <option value=\"\" disabled>Selecione uma linguagem</option>\r\n                      <option>Musica</option><option>Artes visuais</option><option>Teatro e danca</option><option>Literatura</option><option>Cultura popular</option>\r\n                    </select>\r\n                  </label>\r\n                  <label>Voce se inscreve como *\r\n                    <select name=\"profile\" required defaultValue=\"\"><option value=\"\" disabled>Selecione uma opcao</option><option>Artista individual</option><option>Coletivo artistico</option><option>Grupo cultural</option></select>\r\n                  </label>\r\n                  <label className=\"full-width\">Resumo da proposta *<textarea name=\"summary\" required rows={5} placeholder=\"Conte brevemente o que voce pretende realizar, para quem e onde.\" /></label>\r\n                  <label className=\"upload-field full-width\">Portfolio ou material de apoio\r\n                    <input name=\"portfolio\" type=\"file\" accept=\".pdf,.jpg,.jpeg,.png\" />\r\n                    <span>PDF ou imagem, ate 10 MB</span>\r\n                  </label>\r\n                  <label className=\"consent full-width\"><input type=\"checkbox\" required /> <span>Li e concordo com o regulamento do edital e com o uso dos meus dados para esta inscricao.</span></label>\r\n                </div>\r\n                <div className=\"form-actions\"><span>Revise seus dados antes de enviar.</span><button className=\"details-button\" type=\"submit\">Enviar inscricao <span aria-hidden=\"true\">&rarr;</span></button></div>\r\n              </form>\r\n            )}\r\n          </section>\r\n        </section>\r\n      </main>\r\n    );\r\n  }\r\n\r\n  return (\r\n    <main className=\"app-shell\">\r\n      <header className=\"site-header\">\r\n        <a className=\"brand\" href=\"#inicio\" aria-label=\"Cultura em movimento, inicio\">\r\n          <span className=\"brand-mark\">C</span>\r\n          <span>Cultura<br />em movimento</span>\r\n        </a>\r\n        <nav aria-label=\"Navegacao principal\">\r\n          <a className=\"nav-active\" href=\"#agenda\">Agenda</a>\r\n          <button type=\"button\" onClick={() => setActiveView('editais')}>Editais</button>\r\n          <a href=\"#sobre\">Sobre</a>\r\n        </nav>\r\n        <button className=\"calendar-button\" type=\"button\">Ver calendario</button>\r\n      </header>\r\n\r\n      <section className=\"hero\" id=\"inicio\" aria-labelledby=\"page-title\">\r\n        <div>\r\n          <p className=\"eyebrow\">Agenda cultural do municipio</p>\r\n          <h1 id=\"page-title\">Tem coisa boa acontecendo perto de voce.</h1>\r\n          <p className=\"hero-copy\">Descubra encontros, artistas e experiencias que fazem a cidade pulsar.</p>\r\n        </div>\r\n        <p className=\"date-stamp\"><strong>SET</strong><span>2026</span></p>\r\n      </section>\r\n\r\n      <section className=\"featured-event\" aria-labelledby=\"featured-title\">\r\n        <img\r\n          src=\"https://images.unsplash.com/photo-1524368535928-5b5e00ddc76b?auto=format&fit=crop&w=1400&q=85\"\r\n          alt=\"Show ao vivo com luzes coloridas\"\r\n        />\r\n        <div className=\"featured-content\">\r\n          <p className=\"eyebrow\">Em destaque</p>\r\n          <p className=\"event-category\">Festival</p>\r\n          <h2 id=\"featured-title\">Festival Raizes da Cidade</h2>\r\n          <p className=\"featured-description\">Tres dias de musica, sabores e historias que celebram quem faz a nossa cultura.</p>\r\n          <dl className=\"event-details\">\r\n            <div><dt>Quando</dt><dd>18 a 20 de setembro</dd></div>\r\n            <div><dt>Onde</dt><dd>Parque Municipal</dd></div>\r\n          </dl>\r\n          <button className=\"details-button\" type=\"button\">Conhecer evento <span aria-hidden=\"true\">&rarr;</span></button>\r\n        </div>\r\n      </section>\r\n\r\n      <section className=\"agenda\" id=\"agenda\" aria-labelledby=\"agenda-title\">\r\n        <div className=\"section-heading\">\r\n          <div>\r\n            <p className=\"eyebrow\">Programe-se</p>\r\n            <h2 id=\"agenda-title\">Proximos eventos</h2>\r\n          </div>\r\n          <a href=\"#todos\">Ver agenda completa <span aria-hidden=\"true\">&rarr;</span></a>\r\n        </div>\r\n        <div className=\"filters\" aria-label=\"Filtrar eventos por categoria\">\r\n          <button className=\"filter active\" type=\"button\">Todos</button>\r\n          <button className=\"filter\" type=\"button\">Musica</button>\r\n          <button className=\"filter\" type=\"button\">Artes visuais</button>\r\n          <button className=\"filter\" type=\"button\">Cena</button>\r\n        </div>\r\n        <div className=\"event-grid\">\r\n          {events.map((event) => (\r\n            <article className=\"event-card\" key={event.title}>\r\n              <div className=\"event-image-wrap\">\r\n                <img src={event.image} alt=\"\" />\r\n                <time className={`date-badge ${event.tone}`} dateTime={`2026-09-${event.day}`}>\r\n                  <strong>{event.day}</strong><span>{event.month}</span>\r\n                </time>\r\n              </div>\r\n              <div className=\"card-content\">\r\n                <p className=\"event-category\">{event.category}</p>\r\n                <h3>{event.title}</h3>\r\n                <p className=\"event-meta\">{event.place} <span>&bull;</span> {event.time}</p>\r\n              </div>\r\n            </article>\r\n          ))}\r\n        </div>\r\n      </section>\r\n    </main>\r\n  );\r\n}\r\n\r\nexport default App;","import React from 'react';\r\nimport ReactDOM from 'react-dom';\r\nimport App from './App';\r\nimport './index.css';\r\n\r\nReactDOM.render(\r\n  <React.StrictMode>\r\n    <App />\r\n  </React.StrictMode>,\r\n  document.getElementById('root'),\r\n);","// extracted by mini-css-extract-plugin"]}}